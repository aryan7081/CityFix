# Django
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost

# Database
POSTGRES_DB=cityfix
POSTGRES_USER=cityfix
POSTGRES_PASSWORD=cityfix
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Duplicate detection thresholds
DUPLICATE_DISTANCE_METERS=100
DUPLICATE_TEXT_SIMILARITY=0.45
DUPLICATE_MIN_SCORE=0.6

# Priority weights (must sum conceptually; used as multipliers)
PRIORITY_WEIGHT_SEVERITY=0.35
PRIORITY_WEIGHT_SUPPORTS=0.30
PRIORITY_WEIGHT_AGE=0.20
PRIORITY_WEIGHT_CATEGORY=0.15
